    "": {},
    "\n\nLa configuration sera écrite, mais le serveur peut ne pas fonctionner tant que ces points ne sont pas résolus. Aucun test de connexion réussi n’est garanti.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nThe configuration will be written, but the server may not work until these issues are resolved. This does not guarantee a successful connection test."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nLa configuration sera écrite, mais le serveur peut ne pas fonctionner tant que ces points ne sont pas résolus. Aucun test de connexion réussi n’est garanti."
          }
        }
      }
    },
